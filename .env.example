# Copy to .env and edit. .env is gitignored and must not be submitted.
# Every key has a default in config.py; only set what you change.

# --- model -------------------------------------------------------------
# Primary provider, a local model on Ollama. Pull whichever tag you set below:
#   ollama pull <MODEL>
#
# Model choice matters more here than any prompt edit. A small model was tried
# first and was not enough for the drafting stage: it never once chose "no reply
# needed" for a status update -- it answered those by handing the message back --
# and on the single press enquiry the grounded-reply capability turns on, three
# consecutive runs gave a correct cited answer, a garbled one, and one that
# contradicted the evidence while citing an unrelated message. All three were
# held by the post-hoc checks rather than by the model. A larger local model is
# steady on the same prompts, and slower, which is why the timeout below is
# generous. Nothing in the code depends on which one you pick.
PROVIDER=ollama
MODEL=gemma4:e4b
OLLAMA_HOST=http://localhost:11434

# Fallback, used when Ollama cannot be reached at all. Leave FALLBACK_PROVIDER
# empty to disable. The key lives only in .env, which is gitignored and is not
# part of the submission.
#
# Gemini can also be the primary: set PROVIDER=gemini. A full 100-message run
# needs 34 model calls, so on the free tier it costs 34 requests and finishes in
# two or three minutes rather than twenty.
FALLBACK_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# --- rate limits -------------------------------------------------------
# Seconds between model calls. Empty means 0 on Ollama and 4.5 on Gemini, which
# is about thirteen requests a minute against a free-tier limit of fifteen.
# Raise it if the daily cap is tight; 429 and 5xx are retried MAX_RETRIES times
# with exponential backoff, honouring Retry-After, and a message whose call
# never succeeds is escalated rather than guessed at.
CALL_SPACING_SECONDS=

# Messages per model call. 1 keeps every message in its own context, which is
# both the safe default and the fast one on a local model: batching does not
# reduce the tokens generated, so on CPU it is slower, not faster. Raise it only
# on a rate-limited API such as Gemini, where the cost is requests, not compute.
# Messages the rules mark sensitive are never batched at any setting.
BATCH_SIZE=1
MAX_RETRIES=3
TEMPERATURE=0.1
REQUEST_TIMEOUT_S=300

# --- retrieval (Part 3) ------------------------------------------------
# How many messages may ground one decision. Five is enough for this inbox:
# grounded messages average 2.7 pieces of evidence and none reaches the cap.
RETRIEVAL_K=5

# Limits how far back the keyword tier may look, in days. Empty means unbounded,
# which is correct here: the inbox spans eight days, so any window wide enough
# to be safe changes nothing, and a narrower one silently loses grounding (a
# one-day window still finds something for m019, so it never widens, and quietly
# drops m036 -- the message that actually holds the date). It exists for a real
# mailbox, and it applies to the keyword tier only: threads outlive any window,
# and an exact reference is worth finding however old it is.
RETRIEVAL_WINDOW_DAYS=

# Embeddings are the seam, not a feature. The tiers are lexical because the
# query is derived from the message rather than typed as a question, so query
# and target share vocabulary; measured recall on the nine known groundings is
# 9/9 without them. Turning this on would add a vector tier over the same
# already-scoped candidates -- a few hundred, so a flat scan, no vector store.
EMBEDDINGS=off

# --- files -------------------------------------------------------------
OWNER=sam@paperjet.io
INBOX_FILE=data/inbox.json
STATE_DIR=state
TRACE_FILE=trace.jsonl
